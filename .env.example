# 이 파일은 필요한 환경 변수의 "이름"만 공유한다. 실제 값은 .env에 넣고 커밋하지 않는다.
# 새 환경 변수를 추가하면 여기에도 이름을 추가한다.

# Supabase 백엔드 (ClassHub LMS)
# 실제 값은 .env 또는 .streamlit/secrets.toml 에 넣는다(둘 다 .gitignore 처리됨).
# publishable 키는 클라이언트 공개용이며 RLS로 보호된다.
SUPABASE_URL=
SUPABASE_KEY=

# 공개 배포: 1 이면 로그인 화면의 '데모 계정으로 바로 둘러보기' 버튼을 숨긴다.
# (Dockerfile 기본값은 1. 로컬 개발에서는 비워 두면 버튼이 보인다.)
HIDE_DEMO_LOGINS=
